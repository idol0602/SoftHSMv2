# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG: UNIVERSAL CLOUD SOFTHSMV2 REST API
# Dùng chung cho nhiều hệ thống: Fintech, E-Commerce, Hợp đồng điện tử, Đấu giá,...
# ==============================================================================

# Khóa bảo mật API chính (Truyền qua HTTP Header: X-API-Key)
API_KEY=crypto-hsm-super-secret-key-change-me

# Hỗ trợ phân quyền nhiều API Key cho nhiều dự án độc lập (cách nhau bởi dấu phẩy)
# Ví dụ: API_KEYS=crm_app_key_123,invoice_service_key_456,auction_app_key_789
API_KEYS=

# Cấu hình SoftHSMv2
SOFTHSM2_CONF=/etc/softhsm2.conf
HSM_LIB_PATH=/usr/lib/softhsm/libsofthsm2.so

# Nhãn Token lưu trữ khóa dùng chung trong SoftHSM
HSM_TOKEN_LABEL=DefaultCryptoToken

# Mã PIN quản trị (Security Officer PIN) dùng khi init/reset token (4-255 ký tự)
HSM_SO_PIN=12345678

# Mã PIN người dùng (User PIN) dùng để mở Session thực hiện ký/mã hóa (4-255 ký tự)
HSM_PIN=1234

# Cấu hình cổng mạng và môi trường
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=INFO

# Cấu hình Sao lưu tự động lên Supabase Cloud Storage (Bảo toàn Token trên Render/Koyeb)
ENABLE_CLOUD_BACKUP=true
SUPABASE_URL=https://legpvxckbitwatyeiiqb.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxlZ3B2eGNrYml0d2F0eWVpaXFiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4OTk2NDEsImV4cCI6MjEwMzQ3NTY0MX0.yHqHznFPgWBSNcofxtD2SI9-19sUmZj4nX1AsvWFZ84
SUPABASE_BUCKET=pdf-files
SUPABASE_BACKUP_PATH=backups/softhsm_tokens.tar.gz
HSM_TOKEN_DIR=/var/lib/softhsm/tokens
